<!--
  Strip smoke harness (STRIP_PLAN_V2.md section 5 step 5, issues #23-#27). strip/smoke/run.sh builds it once
  per TurboBC.<x>.dll: the client side references that DLL (namespaces rewritten to
  TurboHTTP.SecureProtocol.Org.BouncyCastle), the server and tooling side a full upstream build of strip/BASE
  (BouncyCastle.Cryptography, namespaces Org.BouncyCastle). The two share no types and meet only over byte
  streams. Every *.cs below this directory is compiled; rows register themselves (harness/SmokeRowGroup.cs).

  Build by hand: dotnet build strip/smoke/TurboSmoke.csproj -p:TurboBcDll=<TurboBC.x.dll>
                 -p:UpstreamBcDll=<BouncyCastle.Cryptography.dll of BASE>
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- C# 9 like the consumer code SmokeTlsClient mirrors (turboHTTP, Unity 2021.3). -->
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>TurboSmoke</AssemblyName>
    <RootNamespace>TurboSmoke</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TurboBC">
      <HintPath>$(TurboBcDll)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BouncyCastle.Cryptography">
      <HintPath>$(UpstreamBcDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="TurboSmokeCheckReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(TurboBcDll)' == '' Or !Exists('$(TurboBcDll)')"
           Text="TurboSmoke: set -p:TurboBcDll=&lt;path to TurboBC.x.dll&gt; (got '$(TurboBcDll)')" />
    <Error Condition="'$(UpstreamBcDll)' == '' Or !Exists('$(UpstreamBcDll)')"
           Text="TurboSmoke: set -p:UpstreamBcDll=&lt;path to the BASE BouncyCastle.Cryptography.dll&gt; (got '$(UpstreamBcDll)')" />
  </Target>
</Project>
